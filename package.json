{
  "name": "saucedemo-e2e-tests",
  "version": "1.0.0",
  "description": "E2E test automation suite for SauceDemo using Playwright + TypeScript",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:ui": "npx playwright test --ui",
    "test:debug": "npx playwright test --debug",
    "test:mandatory": "npx playwright test --grep @mandatory",
    "test:bonus": "npx playwright test --grep @bonus",
    "test:unit": "npx playwright test src/utils/__tests__/",
    "report": "npx playwright show-report"
  },
  "keywords": [
    "playwright",
    "e2e",
    "testing",
    "saucedemo",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "dotenv": "^18.0.1"
  }
}
